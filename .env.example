# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Both values are public by design (they ship inside the app) and are
# protected by the row level security rules in supabase/schema.sql.
# Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PowerSync instance URL, from the PowerSync Dashboard's Connect button (also public).
# Leave unset to run without offline sync. See docs/powersync-setup.md.
EXPO_PUBLIC_POWERSYNC_URL=
